# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/chilaloshop?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-64-char-random-string"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
FRONTEND_URL="http://localhost:5173,http://localhost:5174"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Supported providers: Resend (smtp.resend.com), SendGrid (smtp.sendgrid.net),
#                      Mailgun, AWS SES, or any standard SMTP server.
# Leave blank to log emails to console (development mode).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ChilaloShop <noreply@yourdomain.com>"
